# /etc/astra/alert.env (owner root, mode 0644: no secret here).
# Recipient of alert e-mails (requires a working local MTA); empty: journal only.
ASTRA_ALERT_TO=
# Public name whose certificate astra-cert-check verifies, and the alert threshold in hours
# (336 for a 90-day certificate).
ASTRA_CERT_HOST=
ASTRA_CERT_MIN_HOURS=336
