# /etc/apache2/astra-proxy-secret.conf (owner root, mode 0600; Apache reads its configuration as root).
# The value must equal the content of /etc/astra/proxy.secret (root:astra 0640). Generate both together:
#   secret=$(openssl rand -hex 32); printf '%s\n' "$secret" > /etc/astra/proxy.secret
#   printf 'RequestHeader set X-Astra-Proxy "%s"\n' "$secret" > /etc/apache2/astra-proxy-secret.conf
RequestHeader set X-Astra-Proxy "REPLACE_WITH_THE_GENERATED_SECRET"
