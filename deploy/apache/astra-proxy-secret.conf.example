# /etc/apache2/astra-proxy-secret.conf (owner root, mode 0600; Apache reads its configuration as root).
# The value must equal the content of /etc/astra/proxy.secret (root:astra 0640). Generate both together,
# with a restrictive umask so neither file is ever world-readable (PHP as www-data must not read them):
#   umask 077; secret=$(openssl rand -hex 32)
#   printf '%s\n' "$secret" | install -o root -g astra -m 0640 /dev/stdin /etc/astra/proxy.secret
#   printf 'RequestHeader set X-Astra-Proxy "%s"\n' "$secret" > /etc/apache2/astra-proxy-secret.conf
#   chmod 0600 /etc/apache2/astra-proxy-secret.conf; unset secret
# Also make sure mod_info (/server-info) is disabled on the shared Apache: it can display configuration.
RequestHeader set X-Astra-Proxy "REPLACE_WITH_THE_GENERATED_SECRET"
