# ASTRA behind nginx: the only public component. Replace PUBLIC_HOST and the certificate paths.
# Use only after the application's own authentication tests pass on the target host.
# The application stays on 127.0.0.1:8765 and is never reachable directly from the network.

limit_req_zone $binary_remote_addr zone=astra_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=astra_all:10m rate=20r/s;

server {
    listen 80;
    listen [::]:80;
    server_name PUBLIC_HOST;
    server_tokens off;
    # ACME HTTP-01 challenges only; everything else goes to HTTPS.
    location ^~ /.well-known/acme-challenge/ { root /var/lib/letsencrypt/webroot; default_type text/plain; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name PUBLIC_HOST;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/PUBLIC_HOST/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/PUBLIC_HOST/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;

    client_max_body_size 64k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 15s;

    # Headers forwarded to the app are set here, never passed through from the client.
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Port "";
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header Forwarded "";
    proxy_read_timeout 30s;
    proxy_connect_timeout 5s;

    location = /login {
        limit_req zone=astra_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8765;
    }
    location / {
        limit_req zone=astra_all burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8765;
    }
}
