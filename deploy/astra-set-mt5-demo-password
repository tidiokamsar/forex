#!/bin/bash
# Stores the password of the MT5 DEMO account for the server-side MT5 bridge, read from the keyboard (not
# echoed), into /etc/astra/mt5-demo.cred (root 0600), handed by systemd LoadCredential to astra-mt5-bridge only.
# The account number and server are not secret: they live in the unit (ASTRA_MT5_LOGIN, ASTRA_MT5_SERVER).
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "Lancer en root"; exit 1; }
read -r -s -p "Mot de passe du compte DEMO MT5 (invisible) : " password; echo
[ "${#password}" -ge 5 ] && [ "${#password}" -le 64 ] || { echo "Mot de passe invalide (5 à 64 caractères)"; exit 2; }
[[ "$password" != *$'\n'* ]] || { echo "Mot de passe invalide"; exit 2; }
umask 077
tmp=$(mktemp /etc/astra/.mt5-demo.XXXXXX)
printf "%s" "$password" > "$tmp"
chown root:root "$tmp"; chmod 0600 "$tmp"; mv "$tmp" /etc/astra/mt5-demo.cred
unset password
echo "Enregistré dans /etc/astra/mt5-demo.cred (root 0600). Seul le service astra-mt5-bridge le reçoit ; ASTRA ne l affiche jamais."
if systemctl cat astra-mt5-bridge.service >/dev/null 2>&1; then
  systemctl enable astra-mt5-bridge.service >/dev/null 2>&1 || true
  systemctl restart astra-mt5-bridge.service && echo "Service astra-mt5-bridge démarré (compte DEMO uniquement, redémarre seul après une panne)."
fi
