# ASTRA authenticated dashboard (read-only for trading). Starting it never starts a trading engine.
# Install: see DEPLOYMENT.md, "Remote dashboard". Code and venv in /opt/astra (root-owned), data in
# /var/lib/astra (StateDirectory, owned by astra, 0700).
[Unit]
Description=ASTRA dashboard (authenticated, SIMULATION only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
# When the unit fails for good (including after the start limit), raise an alert.
OnFailure=astra-alert@%n.service

[Service]
Type=simple
User=astra
Group=astra
WorkingDirectory=/opt/astra/app
EnvironmentFile=/etc/astra/web.env
Environment=PYTHONPATH=/opt/astra/app/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/astra/venv/bin/gunicorn -c /opt/astra/app/deploy/gunicorn.conf.py "astra.webapp:create_app_from_env()"
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=astra
StateDirectoryMode=0700

# Sandboxing: no privilege, read-only system, writable state directory only, loopback network only.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
RemoveIPC=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Needs cgroup v2 with BPF (Ubuntu 24.04 provides it); check that outbound traffic is really refused.
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
