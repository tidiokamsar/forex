# Loads the loopback port rule before the dashboard. astra-web requires this unit: without the rule,
# the dashboard does not start (fail closed). Only this table is touched; the host's other rules stay.
[Unit]
Description=ASTRA loopback port filter (only the proxy may reach 127.0.0.1:8765)
Before=astra-web.service
After=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/sbin/nft -c -f /opt/astra/app/deploy/nftables/astra-loopback.nft
ExecStart=/usr/sbin/nft -f /opt/astra/app/deploy/nftables/astra-loopback.nft
ExecStop=/usr/sbin/nft destroy table inet astra_loopback

[Install]
RequiredBy=astra-web.service
