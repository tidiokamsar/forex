# Daily verified SQLite backups of the ASTRA database (candles, backtests, simulations, jobs) and of the
# account database, owner-only files in /var/lib/astra/backups (14 kept each). The MFA key ring is NOT
# copied here: back it up separately, off the host. Run by astra-backup.timer; a failure raises the alert.
[Unit]
Description=ASTRA database backups
OnFailure=astra-alert@%n.service

[Service]
Type=oneshot
User=astra
Group=astra
WorkingDirectory=/opt/astra/app
EnvironmentFile=/etc/astra/web.env
Environment=PYTHONPATH=/opt/astra/app/src
UMask=0077
StateDirectory=astra
ExecStart=/opt/astra/venv/bin/python -m astra backup create --dir /var/lib/astra/backups/astra
ExecStart=/usr/bin/env ASTRA_DATABASE=/var/lib/astra/auth.sqlite3 /opt/astra/venv/bin/python -m astra backup create --dir /var/lib/astra/backups/auth
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
IPAddressDeny=any
