#!/usr/sbin/nft -f
# Only the reverse proxy's user (and the ASTRA service itself, for its local checks) may connect to the
# dashboard's loopback port. Any other local process is refused before reaching the application; the
# proxy secret header (X-Astra-Proxy) is the second barrier if the proxy user is shared with another
# application (for example PHP running as www-data). Loaded by astra-nft.service, required by astra-web.
# Idempotent (nft >= 1.0.8): the table is replaced, never duplicated. Check with: nft -c -f <this file>.
table inet astra_loopback
destroy table inet astra_loopback
table inet astra_loopback {
    chain output {
        type filter hook output priority filter; policy accept;
        ip daddr 127.0.0.1 tcp dport 8765 meta skuid != { "www-data", "astra" } counter drop
        ip6 daddr ::1 tcp dport 8765 meta skuid != { "www-data", "astra" } counter drop
    }
}
