# /etc/astra/web.env (owner root, group astra, mode 0640). No secret belongs in this file:
# the CSRF key is generated in ASTRA_WEB_SECRET_FILE (0600) and passwords live only as Argon2id hashes.
ASTRA_MODE=SIMULATION
ASTRA_DATABASE=/var/lib/astra/astra.sqlite3
ASTRA_AUTH_DATABASE=/var/lib/astra/auth.sqlite3
ASTRA_WEB_SECRET_FILE=/var/lib/astra/web_secret.key
# Exact public name served by the TLS proxy (several names: comma-separated). Requires ASTRA_HTTPS=1.
ASTRA_PUBLIC_HOSTS=
ASTRA_HTTPS=1
# The only client of 127.0.0.1:8765 is the local proxy, which overwrites X-Forwarded-For.
ASTRA_TRUSTED_PROXY=1
