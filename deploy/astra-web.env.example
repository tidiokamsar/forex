# /etc/astra/web.env (owner root, group astra, mode 0640). No secret belongs in this file:
# the CSRF key is generated in ASTRA_WEB_SECRET_FILE (0600), passwords live only as Argon2id hashes and
# the proxy secret is a separate file.
ASTRA_MODE=SIMULATION
ASTRA_DATABASE=/var/lib/astra/astra.sqlite3
ASTRA_AUTH_DATABASE=/var/lib/astra/auth.sqlite3
ASTRA_WEB_SECRET_FILE=/var/lib/astra/web_secret.key
# Key ring of the TOTP secrets (root:astra 0640), kept outside /var/lib/astra and its backups.
ASTRA_MFA_KEY_FILE=/etc/astra/mfa.key
# astra backup create writes here (the code directory is read-only).
ASTRA_BACKUP_DIR=/var/lib/astra/backups

# Private mode (default): reachable only on the host or through `ssh -L 8765:127.0.0.1:8765 <host>`.
ASTRA_PUBLIC_HOSTS=
ASTRA_HTTPS=0
ASTRA_TRUSTED_PROXY=0

# Public mode, only after the go-live checklist in DEPLOYMENT.md (replace the three lines above):
# ASTRA_PUBLIC_HOSTS=<dedicated DNS name>
# ASTRA_HTTPS=1
# ASTRA_TRUSTED_PROXY=1
# ASTRA_PROXY_SECRET_FILE=/etc/astra/proxy.secret
