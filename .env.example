# Documentation only: ASTRA does not load .env files automatically.
ASTRA_MODE=SIMULATION
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8765
ASTRA_DATA_DIR=data
ASTRA_DATABASE=var/astra.sqlite3
# Optional: rotating JSON log file directory and level.
ASTRA_LOG_DIR=
ASTRA_LOG_LEVEL=WARNING
ASTRA_BACKUP_DIR=var/backups
# Evidence anchor outside SQLite (lot 4). The only adapter is a local file and is NOT
# production grade; set it before the first seal: a store is bound to its first anchor.
ASTRA_EVIDENCE_ANCHOR=

# cTrader DEMO read-only check (python -m astra ctrader-check --operator <name>).
# Set these in your own shell session only. Never commit real values.
ASTRA_CTRADER_ACCOUNT_ID=
ASTRA_SECRET_CTRADER_CLIENT_ID=
ASTRA_SECRET_CTRADER_CLIENT_SECRET=
ASTRA_SECRET_CTRADER_ACCESS_TOKEN=
